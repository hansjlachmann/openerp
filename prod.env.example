# Server settings for docker-compose.prod.yml — copy to prod.env on the server and fill in:
#   cp prod.env.example prod.env && chmod 600 prod.env
# prod.env is not tracked by git (it holds secrets). scripts/prod.sh passes it to docker compose.

# Release to run (upgrade: change it, then scripts/prod.sh pull && scripts/prod.sh up -d)
APP_VERSION=0.1.82

# Session signing key; without it every restart logs all users out. Generate once:
#   openssl rand -hex 32
JWT_SECRET=

# Key that encrypts secrets stored in the database (the SMTP password). Optional: empty means
# a key derived from JWT_SECRET. Set it (openssl rand -hex 32) to change JWT_SECRET later
# without having to enter the SMTP password again. Changing this key itself means the SMTP
# password has to be entered again in SMTP Setup.
OPENERP_ENCRYPTION_KEY=

# Postgres password of user "openerp". Only applied when the database volume is created —
# on an existing installation change it in the database first (docs/operations.md), then here.
POSTGRES_PASSWORD=openerp

# Where the backend (8080) and frontend (3000) ports are published. 127.0.0.1 = only on this
# host (a tunnel or proxy on the same machine); 0.0.0.0 = the whole network (only if a proxy on
# another machine must reach them). Users normally come through nginx on 80/443.
PUBLISH_HOST=127.0.0.1

# NAV report proxy for the NAV Report Runner codeunit (Job Queue). Empty: http://localhost:5009,
# which inside the backend container is the container itself — set the proxy's real address.
NAV_PROXY_URL=
